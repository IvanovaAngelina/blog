[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[submodule]
	active = .
[remote "origin"]
	url = git@github.com:IvanovaAngelina/blog.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[submodule "public"]
	url = https://github.com/IvanovaAngelina/IvanovaAngelina.github.io.git
[submodule "IvanovaAngelina.github.io"]
	url = https://github.com/IvanovaAngelina/IvanovaAngelina.github.io.git
